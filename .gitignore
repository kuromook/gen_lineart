__pycache__/
.ipynb_checkpoints/
# `venv` without a slash on purpose: in several track trees venv is a SYMLINK
# to this one, and `venv/` does not match a symlink (found 2026-10-24, when
# importing this file into the dormant trees left the symlink untracked).
venv
# `.claude/*` without the trailing-slash form on purpose: `.claude/` excludes the
# directory wholesale and git never reconsiders the negations inside it (same family
# as the `venv` note above). Only `settings.json` is tracked -- it carries the hooks,
# so the law's enforcement arm travels with the branch. `settings.local.json` holds
# this machine's permissions and stays ignored.
.claude/*
!.claude/settings.json

checkpoints/*
!checkpoints/README.md

dataset/*
!dataset/README.md
img/

debug_output/
/MEMORY.md

*.log
*.pid
*.zip
logs/

# Generated experiment outputs. Existing tracked result snapshots remain
# tracked; add new representative artifacts explicitly with `git add -f`.
results/**
!results/
!results/README.md
!results/lessons/
!results/lessons/**

# Local notification secrets / endpoints.
config/autoloop_notify.env

# Local file-exchange with the extraction-tool session (Windows machine).
inbox/
outbox/

# 原稿由来の納品物(抽出ツールからの SCP 受け)。dataset/ と同じ扱いで追跡しない
data/
